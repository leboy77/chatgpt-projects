# mock: fully local placeholders for development
# openai: OpenAI or an OpenAI-compatible Images API
IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_REQUEST_TIMEOUT=180

VISUALFORGE_DATA_DIR=./data
VISUALFORGE_HOST=127.0.0.1
VISUALFORGE_PORT=8765
VISUALFORGE_WORKERS=2
VISUALFORGE_MAX_ATTEMPTS=2
# Optional override; defaults to <Desktop>\VisualForge商品图 on Windows.
VISUALFORGE_EXPORT_DIR=

