{
  "manifest_version": 3,
  "name": "Temu 下架与主图归档",
  "version": "2.4.1",
  "description": "按 SPU 查询 Temu 商品，自动保存主图并申请下架。",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1:54345/*",
    "https://agentseller.temu.com/*",
    "https://agentseller-eu.temu.com/*",
    "https://*.kwcdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Temu 下架与主图归档",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://agentseller.temu.com/*",
        "https://agentseller-eu.temu.com/*"
      ],
      "js": [
        "vendor/xlsx.full.min.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "sidepanel.js",
        "shared.js",
        "page-bridge.js",
        "vendor/xlsx.full.min.js",
        "templates/*",
        "icons/*"
      ],
      "matches": [
        "https://agentseller.temu.com/*",
        "https://agentseller-eu.temu.com/*"
      ]
    }
  ]
}
