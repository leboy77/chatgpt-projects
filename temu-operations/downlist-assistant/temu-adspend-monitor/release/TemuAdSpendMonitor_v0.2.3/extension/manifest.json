{
  "manifest_version": 3,
  "name": "Temu 商品推广花费监控",
  "version": "0.2.3",
  "description": "监控 Temu 商品推广今日花费，按 SPU 阈值告警，并可在明确授权后自动暂停。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://ads.temu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Temu 商品推广花费监控"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ads.temu.com/ad-list.html*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://ads.temu.com/*"
      ]
    }
  ]
}
