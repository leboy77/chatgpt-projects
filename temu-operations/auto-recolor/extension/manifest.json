{
  "manifest_version": 3,
  "name": "TEMU 商品图片自动编辑助手",
  "version": "0.10.14",
  "description": "在 TEMU 商家中心按 SKC 批量新增色值并自动补正面图/背面图，最后自动提交。",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://agentseller.temu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://agentseller.temu.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page/main.js"
      ],
      "matches": [
        "https://agentseller.temu.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "TEMU 图片助手（面板显示在页面右下角）"
  }
}
